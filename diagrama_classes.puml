Categoria "1" -- "N" Servico
Servico "1" -- "N" UrlServico
Servico "1" -- "N" Credencial
Usuario "1" -- "N" Credencial
Usuario "1" -left- "N" Backup
Usuario "1" -- "N" Preferencia
Usuario "1" -- "N" Dispositivo

UrlServico "1" -- "N" ConfiguracaoLogin
Credencial "1" -- "N" ConfiguracaoLogin
Credencial "1" -left- "N" AlertaSeguranca
Credencial "1" -- "N" MetodoAutenticacao
Credencial "1" -- "N" EmailRecuperacao
Credencial "1" -- "N" HistoricoCredencial
Credencial "1" -- "N" SessaoNavegador
Credencial "1" -right- "N" EventoAuditoria
Dispositivo "1" --- "N" SessaoNavegador
Dispositivo "1" -- "N" EventoAuditoria
Usuario "1" -- "N" EventoAuditoria

@enduml
