- parametrosKdf : String
- dekCriptografada : byte[]
- dekNonce : byte[]
- ativo : boolean
- criadoEm : Date
- atualizadoEm : Date
- ultimoAcessoEm : Date
+ cadastrar()
+ consultar()
+ editar()
+ excluir()
+ desbloquear()
+ bloquear()
+ alterarSenhaMestre()
}

